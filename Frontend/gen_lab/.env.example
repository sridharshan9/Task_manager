# Leave empty (default) to use the same origin as the app.
# In development the CRA dev server proxies /api to the backend (see "proxy" in package.json).

# --- Deploying to Vercel ---
# Set this in the Vercel project settings (Environment Variables) to your Render
# backend URL, then redeploy:
#   REACT_APP_API_URL=https://genlab-taskmanager-api.onrender.com
REACT_APP_API_URL=
